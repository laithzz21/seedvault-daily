{
    "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
    "menu": {
        "items": [
            {
                "description": "Seedvault \u2014 a tiny garden, a new puzzle every day",
                "endpoint": "/internal/menu/post-create",
                "forUserType": "moderator",
                "label": "Create today's garden post",
                "location": "subreddit"
            }
        ]
    },
    "name": "seedvault-daily",
    "post": {
        "dir": "dist/client",
        "entrypoints": {
            "default": {
                "entry": "splash.html",
                "inline": true
            },
            "game": {
                "entry": "game.html"
            }
        }
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch"
    },
    "server": {
        "dir": "dist/server",
        "entry": "index.cjs"
    },
    "triggers": {
        "onAppInstall": "/internal/triggers/on-app-install"
    }
}
